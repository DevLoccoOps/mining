# BLE Tag Tracker — Environment Variables
# Copy this file to .env and adjust values as needed

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ble_tag_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# ── Backend Server ───────────────────────────────────────
SERVER_PORT=8081

# ── Scanner (frontend, for when backend is not on Docker) ─
SCANNER_API_URL=http://localhost:8081
